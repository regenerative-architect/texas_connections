{
  "schema": "txco-partner-playbook",
  "version": 1,
  "asOf": "2026-09-28",
  "principles": [
    "Assign a real owner to every dependency; a logo on a partner list is not implementation.",
    "Separate public evidence, organizational work product and private household/person-level data.",
    "Share the minimum data necessary for the task. Do not place secrets, credentials, protected records or sensitive household data in open peer rooms.",
    "Use common lifecycle states: observed → validated → designed → funded → building → operational → adopted → verified.",
    "Measure infrastructure outputs separately from service use and downstream outcomes."
  ],
  "sectors": [
    {
      "id": "family",
      "name": "Families & households",
      "icon": "🏠",
      "mission": "Define lived barriers, affordability, reliability, accessibility and service-use requirements without surrendering unnecessary personal data.",
      "canContribute": [
        "service-ordering observations",
        "affordability constraints",
        "device/accessibility needs",
        "speed/reliability observations",
        "priority use cases"
      ],
      "needsFromOthers": [
        "plain-language options",
        "verified eligibility",
        "privacy-safe support",
        "clear escalation paths"
      ],
      "typicalHandoffs": [
        "availability discrepancy → mapper/ISP/FCC challenge",
        "device/skills gap → library/navigator",
        "telehealth barrier → clinic/connectivity team"
      ]
    },
    {
      "id": "local-government",
      "name": "Local & county government",
      "icon": "🏛️",
      "mission": "Convene, align rights-of-way/public assets, document public process, coordinate funding and publish accountable project status.",
      "canContribute": [
        "local plans",
        "permitting/ROW context",
        "public facilities",
        "grant coordination",
        "emergency planning"
      ],
      "needsFromOthers": [
        "provider engineering",
        "community evidence",
        "institution requirements",
        "legal/procurement review"
      ],
      "typicalHandoffs": [
        "validated gap → project scoping",
        "public asset → engineering review",
        "funding lead → grant-readiness packet"
      ]
    },
    {
      "id": "state-public",
      "name": "State agencies & public institutions",
      "icon": "★",
      "mission": "Provide program rules, authoritative datasets, grants, procurement pathways and sector-specific standards.",
      "canContribute": [
        "official data",
        "program guidance",
        "funding rules",
        "technical assistance",
        "statewide coordination"
      ],
      "needsFromOthers": [
        "accurate local evidence",
        "compliant applications",
        "implementation reporting"
      ],
      "typicalHandoffs": [
        "program rule → applicant checklist",
        "state dataset → local validation",
        "award → implementation monitoring"
      ]
    },
    {
      "id": "education",
      "name": "Schools, colleges & educational bodies",
      "icon": "🎓",
      "mission": "Translate connectivity into learning, administration, safety and workforce requirements while protecting student data.",
      "canContribute": [
        "E-Rate planning",
        "campus network requirements",
        "digital learning needs",
        "facilities",
        "training pathways"
      ],
      "needsFromOthers": [
